# ==============================================================================
# Variables de entorno — AuthApp CI
# ==============================================================================
# Este proyecto es infraestructura de CI/CD (Jenkins + SonarQube) orquestada con
# Docker Compose. No expone una aplicación con configuración por entorno: las
# únicas variables sensibles son las del análisis de SonarQube.
#
# Copia este archivo a `.env` y completa los valores para tu entorno local:
#   cp .env.example .env
#
# NUNCA subas tu archivo `.env` con valores reales al repositorio.
# Ver SECURITY.md y docs/conventions/secrets.md.
# ==============================================================================

# ── SonarQube ─────────────────────────────────────────────────────────────
# URL del servidor de SonarQube (dentro de la red de Docker Compose es
# http://sonarqube:9000; desde tu host es http://localhost:9000).
SONAR_HOST_URL=http://sonarqube:9000

# Token de análisis generado en SonarQube:
#   http://localhost:9000 > My Account > Security > Generate Tokens
# NO lo hardcodees en el Jenkinsfile. En Jenkins guárdalo como credencial
# (Manage Jenkins > Credentials, tipo "Secret text") y referéncialo en el job.
SONAR_TOKEN=

# Clave del proyecto en SonarQube.
SONAR_PROJECT_KEY=authapp

# ── Jenkins (opcional) ────────────────────────────────────────────────────
# Puerto en el que se publica la UI de Jenkins (por defecto 8080).
JENKINS_PORT=8080
